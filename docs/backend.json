{
  "entities": {
    "QuoteRequest": {
      "title": "Quote Request",
      "description": "Information from prospective clients requesting a CCTV installation quote.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "propertyType": { "type": "string", "enum": ["Residential", "Business", "Commercial", "Other"] },
        "camerasCount": { "type": "number" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "email", "propertyType", "camerasCount"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/quote_requests/{requestId}": {
      "schema": "QuoteRequest",
      "description": "Secure storage for customer inbound quote requests."
    }
  }
}